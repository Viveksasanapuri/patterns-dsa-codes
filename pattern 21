def print21(n):
    spaces = 2 * n - 2

    for i in range(1, 2 * n):
        stars = i if i <= n else 2 * n - i
        print("*" * stars + " " * spaces + "*" * stars)

        if i < n:
            spaces -= 2
        else:
            spaces += 2


n = int(input())
print21(n)

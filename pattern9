def print7(n):
    for i in range(n):
        for j in range(n-i-1):
            print(" ",end="")
        for j in range(2*i+1):
            print("*",end="")
        for j in range(n-i-1):
            print(" ",end="")
        print()

print7(n)
def print8(n):
    for i in range(n):
        for j in range(i):
            print(" ",end="")
        for j in range(2*n-(2*i+1)):
            print("*",end="")
        for j in range(i):
            print(" ",end="")
        print()

print8(n)
n=int(input())

def print12(n):
    space = 2 * (n - 1)

    for i in range(1, n + 1):
        # Print increasing numbers
        for j in range(1, i + 1):
            print(j, end="")

        # Print spaces
        print(" " * space, end="")

        # Print decreasing numbers
        for j in range(i, 0, -1):
            print(j, end="")

        print()
        space -= 2


n = int(input())
print12(n)
